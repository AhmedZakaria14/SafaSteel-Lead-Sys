rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'azeco77@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'fullName'])
        && data.keys().hasOnly(['uid', 'email', 'fullName', 'defaultLanguage', 'theme', 'updatedAt'])
        && data.uid is string && data.uid == request.auth.uid && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 254
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 160
        && (!('defaultLanguage' in data) || (data.defaultLanguage is string && data.defaultLanguage in ['ar', 'en']))
        && (!('theme' in data) || (data.theme is string && data.theme in ['light', 'dark']));
    }

    function isValidBusiness(data) {
      return data.keys().hasAll(['name', 'ownerUid', 'isDemo'])
        && data.keys().hasOnly(['name', 'industry', 'ownerUid', 'isDemo', 'updatedAt'])
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 160
        && data.ownerUid is string && data.ownerUid == request.auth.uid && data.ownerUid.size() <= 128
        && data.isDemo is bool
        && (!('industry' in data) || (data.industry is string && data.industry.size() <= 100));
    }

    function isValidLead(data, businessId) {
      return data.keys().hasAll(['businessId', 'fullName', 'statusKey'])
        && data.keys().hasOnly(['businessId', 'fullName', 'phone', 'email', 'statusKey', 'assignedToUid', 'updatedAt'])
        && data.businessId is string && data.businessId == businessId && data.businessId.size() <= 128
        && data.fullName is string && data.fullName.size() >= 1 && data.fullName.size() <= 160
        && data.statusKey is string && data.statusKey.size() >= 1 && data.statusKey.size() <= 64
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 40))
        && (!('email' in data) || (data.email is string && data.email.size() <= 254))
        && (!('assignedToUid' in data) || (data.assignedToUid is string && data.assignedToUid.size() <= 128));
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin());
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId && isValidUserProfile(incoming());
      allow update: if isSignedIn() && isValidId(userId) && (request.auth.uid == userId || isAdmin())
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'defaultLanguage', 'theme', 'updatedAt']);
      allow delete: if false;
    }

    match /businesses/{businessId} {
      allow get: if isSignedIn() && isValidId(businessId) && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (existing().ownerUid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(businessId) && isValidBusiness(incoming());
      allow update: if isSignedIn() && isValidId(businessId) && (existing().ownerUid == request.auth.uid || isAdmin())
        && isValidBusiness(incoming())
        && incoming().ownerUid == existing().ownerUid
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'industry', 'updatedAt']);
      allow delete: if isSignedIn() && isValidId(businessId) && (existing().ownerUid == request.auth.uid || isAdmin());

      match /leads/{leadId} {
        allow get: if isSignedIn() && isValidId(businessId) && isValidId(leadId)
          && (get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid || isAdmin());
        allow list: if isSignedIn() && isValidId(businessId)
          && (get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid || isAdmin());
        allow create: if isSignedIn() && isValidId(businessId) && isValidId(leadId)
          && isValidLead(incoming(), businessId)
          && (get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid || isAdmin());
        allow update: if isSignedIn() && isValidId(businessId) && isValidId(leadId)
          && isValidLead(incoming(), businessId)
          && incoming().businessId == existing().businessId
          && incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phone', 'email', 'statusKey', 'assignedToUid', 'updatedAt'])
          && (get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid || isAdmin());
        allow delete: if isSignedIn() && isValidId(businessId) && isValidId(leadId)
          && (get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid || isAdmin());
      }
    }
  }
}
