# GEMINI_API_KEY: Optional if AI features are enabled server-side.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# META_APP_SECRET: Meta App Secret used to verify X-Hub-Signature-256 on /api/webhooks/meta
META_APP_SECRET=""

# META_WEBHOOK_VERIFY_TOKEN: Secret verify token configured in Meta App Webhooks dashboard
META_WEBHOOK_VERIFY_TOKEN=""

# ENCRYPTION_KEY: 32-byte hex/utf8 key for encrypting stored integration tokens at rest on server
INTEGRATION_ENCRYPTION_KEY=""

# DATABASE_PATH: Optional path to persistent SQLite database file (defaults to ./.data/leadflow.db)
DATABASE_PATH=""
